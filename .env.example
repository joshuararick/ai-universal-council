# Copy to .env and paste your key (.env is git-ignored; never commit it).
# Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: only for `python -m council.keys` (manages keys, cannot call models).
# Make one at openrouter.ai > Settings > Provisioning API Keys.
OPENROUTER_PROVISIONING_KEY=
